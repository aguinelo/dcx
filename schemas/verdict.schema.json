{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict",
  "type": "object",
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CriterionVerdict"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerdictIssue"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "approved",
    "criteria",
    "issues",
    "notes"
  ],
  "$defs": {
    "CriterionVerdict": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "criterion_id",
        "passed",
        "evidence"
      ]
    },
    "IssueSeverity": {
      "type": "string",
      "enum": [
        "blocker",
        "non_blocking"
      ]
    },
    "VerdictIssue": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "criterion_id",
        "description",
        "severity"
      ]
    }
  }
}
