# Copie para `.env` e preencha apenas o provider que for usar.
# O `.env` é ignorado pelo Git e não é copiado para o workspace isolado dos runs.

# Provider dos runs: codex | claude | minimax | auto
# `auto` tenta Claude e depois Codex. O padrão é codex.
# HARNESS_PROVIDER=claude

# Provider do chat read-only: claude | minimax
# Se omitido, usa HARNESS_PROVIDER quando ele for claude ou minimax; senão claude.
# HARNESS_CHAT_PROVIDER=minimax

# ---------------------------------------------------------------------------
# MiniMax 3
# ---------------------------------------------------------------------------
# A MiniMax expõe uma API compatível com Anthropic; o harness usa o Claude CLI
# instalado como cliente, com as variáveis abaixo. Use a chave de assinatura
# (sk-cp-...) do painel da MiniMax.
# MINIMAX_API_KEY=sk-cp-substitua-aqui

# Base URL internacional. Para a China use https://api.minimax.cn/anthropic.
# HARNESS_MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Modelo padrão do MiniMax. Também pode ser MiniMax-M3.1-Flash.
# HARNESS_MINIMAX_MODEL=MiniMax-M3

# Alias aceito para a chave, caso prefira manter o prefixo do harness.
# HARNESS_MINIMAX_API_KEY=sk-cp-substitua-aqui

# ---------------------------------------------------------------------------
# Claude (Anthropic)
# ---------------------------------------------------------------------------
# Chave da API Anthropic. Sem ela, o Claude CLI usa o login/assinatura local.
# ANTHROPIC_API_KEY=sk-ant-substitua-aqui

# HARNESS_CLAUDE_MODEL=claude-sonnet-4-5
# HARNESS_CLAUDE_BIN=claude

# ---------------------------------------------------------------------------
# Codex (OpenAI via CLI)
# ---------------------------------------------------------------------------
# O Codex usa a autenticação configurada no próprio CLI.
# HARNESS_CODEX_MODEL=gpt-5-codex
# HARNESS_CODEX_BIN=codex

# ---------------------------------------------------------------------------
# Modelos por papel (opcional)
# ---------------------------------------------------------------------------
# Com Claude, o fallback é HARNESS_CLAUDE_MODEL; com MiniMax, HARNESS_MINIMAX_MODEL.
# HARNESS_ANALYST_MODEL=
# HARNESS_ACCEPTANCE_MODEL=
# HARNESS_PLANNER_MODEL=
# HARNESS_VERIFIER_MODEL=
# HARNESS_CHAT_MODEL=

# Pesquisa externa opcional no chat. 0 mantém o modo somente projeto;
# 1 habilita a pesquisa web nativa do Harness para qualquer modelo.
# HARNESS_CHAT_WEB=0
# Endpoint HTML público usado pelo Harness (sem chave).
# HARNESS_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
# Limite de segurança por turno; evita loops de busca e custo inesperado.
# HARNESS_CHAT_MAX_TOOL_CALLS=8

# Arquivo de ambiente alternativo (opcional).
# HARNESS_ENV_FILE=/caminho/para/outro.env
