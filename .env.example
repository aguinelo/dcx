# Copie para `.env` e preencha apenas o provider que for usar.
# O `.env` é ignorado pelo Git e não é copiado para o workspace isolado dos runs.

# Provider dos runs: codex | claude | minimax | auto
# `auto` tenta Claude e depois Codex. O padrão é codex.
# DCX_PROVIDER=claude

# Provider do chat read-only: claude | minimax
# Se omitido, usa DCX_PROVIDER quando ele for claude ou minimax; senão claude.
# DCX_CHAT_PROVIDER=minimax

# ---------------------------------------------------------------------------
# MiniMax 3
# ---------------------------------------------------------------------------
# A MiniMax expõe uma API compatível com Anthropic; o dcode usa o Claude CLI
# instalado como cliente, com as variáveis abaixo. Use a chave de assinatura
# (sk-cp-...) do painel da MiniMax.
# MINIMAX_API_KEY=sk-cp-substitua-aqui

# Base URL internacional. Para a China use https://api.minimax.cn/anthropic.
# DCX_MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# Modelo padrão recomendado para o Claude CLI.
# DCX_MINIMAX_MODEL=MiniMax-M3.1-Flash

# Alias aceito para a chave, caso prefira manter o prefixo do dcode.
# DCX_MINIMAX_API_KEY=sk-cp-substitua-aqui

# ---------------------------------------------------------------------------
# Claude (Anthropic)
# ---------------------------------------------------------------------------
# Chave da API Anthropic. Sem ela, o Claude CLI usa o login/assinatura local.
# ANTHROPIC_API_KEY=sk-ant-substitua-aqui

# DCX_CLAUDE_MODEL=claude-sonnet-4-5
# DCX_CLAUDE_BIN=claude

# ---------------------------------------------------------------------------
# Codex (OpenAI via CLI)
# ---------------------------------------------------------------------------
# O Codex usa a autenticação configurada no próprio CLI.
# DCX_CODEX_MODEL=gpt-5-codex
# DCX_CODEX_BIN=codex

# ---------------------------------------------------------------------------
# Modelos por papel (opcional)
# ---------------------------------------------------------------------------
# Com Claude, o fallback é DCX_CLAUDE_MODEL; com MiniMax, DCX_MINIMAX_MODEL.
# DCX_ANALYST_MODEL=
# DCX_ACCEPTANCE_MODEL=
# DCX_PLANNER_MODEL=
# DCX_VERIFIER_MODEL=
# DCX_CHAT_MODEL=

# Pesquisa externa opcional no chat. 0 mantém o modo somente projeto;
# 1 habilita a pesquisa web nativa do dcode para qualquer modelo.
# DCX_CHAT_WEB=0
# Endpoint HTML público usado pelo dcode (sem chave).
# DCX_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
# Limite de segurança por turno; evita loops de busca e custo inesperado.
# DCX_CHAT_MAX_TOOL_CALLS=16

# Limites de segurança por execução de código (dcx run / execução promovida).
# O run para antes de iniciar outra chamada ao atingir o limite.
# O custo deve ser reportado pelo provider; com teto definido, Codex é recusado
# porque a CLI não fornece custo. Uma chamada em andamento pode ultrapassar o teto.
# DCX_RUN_MAX_MODEL_CALLS=40
# DCX_RUN_MAX_COST_USD=2.00
# DCX_RUN_MAX_DURATION_MINUTES=120

# Orçamento global da fila (dcx loop). O uso soma todas as tarefas e é
# combinado com os limites por tarefa. A fila pausa ao atingir qualquer limite.
# Ao retomar com estas variáveis, o orçamento salvo é substituído.
# O tempo global considera o tempo ativo das chamadas, sem contar pausas.
# DCX_LOOP_MAX_MODEL_CALLS=80
# DCX_LOOP_MAX_COST_USD=4.00
# DCX_LOOP_MAX_DURATION_MINUTES=240

# Arquivo de ambiente alternativo (opcional).
# DCX_ENV_FILE=/caminho/para/outro.env
